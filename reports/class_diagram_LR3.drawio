<mxfile host="app.diagrams.net"><diagram id="cls" name="Диаграмма классов ЛР3"><mxGraphModel dx="900" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m1" value="React-приложение «Галактики» (4 страницы)" style="shape=module;jettyWidth=10;jettyHeight=6;align=center;verticalAlign=top;fontStyle=1;fontSize=14;html=1;whiteSpace=wrap;spacingTop=4;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="787" height="352" as="geometry"/></mxCell><mxCell id="c2" value="Лента галактик" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="42" y="60" width="178" height="300" as="geometry"/></mxCell><mxCell id="t3" value="- фото / видео галактики&lt;br&gt;- название, описание&lt;br&gt;- сверхновая типа Ia&lt;br&gt;- видимая звёздная величина m&lt;br&gt;- расстояние, Мпк&lt;br&gt;- количество лайков" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" parent="c2"><mxGeometry y="40" width="178" height="100" as="geometry"/></mxCell><mxCell id="l4" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;points=[];portConstraint=eastwest;strokeColor=#000000;" vertex="1" parent="c2"><mxGeometry y="140" width="178" height="2" as="geometry"/></mxCell><mxCell id="t5" value="+ открыть ленту:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;feed()&lt;br&gt;+ стрелка «Следующая»:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;feed(id, next)&lt;br&gt;+ сердечко:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;like(id, 0/1)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" parent="c2"><mxGeometry y="142" width="178" height="158" as="geometry"/></mxCell><mxCell id="c6" value="Каталог галактик (плитка)" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="232" y="60" width="178" height="300" as="geometry"/></mxCell><mxCell id="t7" value="- плитки галактик: фото,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;название, видимая&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;звёздная величина,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;расстояние, лайки&lt;br&gt;- слайдер видимой&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;звёздной величины&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;«от» и «до»" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" parent="c6"><mxGeometry y="40" width="178" height="115" as="geometry"/></mxCell><mxCell id="l8" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;points=[];portConstraint=eastwest;strokeColor=#000000;" vertex="1" parent="c6"><mxGeometry y="155" width="178" height="2" as="geometry"/></mxCell><mxCell id="t9" value="+ кнопка «Найти»:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;list(magnitude_from,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;magnitude_to)&lt;br&gt;+ кнопка «Удалить»:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;remove(id)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" parent="c6"><mxGeometry y=